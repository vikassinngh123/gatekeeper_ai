# Use a persistent PostgreSQL service for deployed environments.
# Example format (replace with your provider's actual connection string):
# DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require

# Comma-separated frontend origins, without trailing slash.
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Keep false for public deployments. When true, the unauthenticated DELETE
# reset endpoint is enabled and is suitable ONLY for a private demo environment.
ENABLE_DEMO_RESET=false
